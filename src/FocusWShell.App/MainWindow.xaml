<Window x:Class="FocusWShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusWShell.App"
        Title="FocusWShell" Width="980" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="DimGray"
                       Text="Cambia el rol de las ventanas y pulsa Aplicar roles. Las nuevas se añaden al final de su panel; las que dejas sin rol vuelven a su sitio original. La columna Estado muestra lo que gestiona FocusWShell ahora." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="PromoteButton" DockPanel.Dock="Left" Content="Al Centro" Padding="12,4" Margin="0,0,8,0" Click="Promote_Click"
                    ToolTip="Lleva la ventana seleccionada al Centro (Ctrl+Alt+Mayús+↑ con la ventana activa)" />
            <Button x:Name="SwapButton" DockPanel.Dock="Left" Content="Volver a la anterior" Padding="12,4" Margin="0,0,8,0" Click="Swap_Click"
                    ToolTip="Devuelve al Centro la ventana que estaba antes (Ctrl+Alt+Mayús+←)" />
            <Button x:Name="ReturnButton" DockPanel.Dock="Left" Content="Centro al panel" Padding="12,4" Margin="0,0,8,0" Click="Return_Click"
                    ToolTip="Devuelve la ventana del Centro a su panel (Ctrl+Alt+Mayús+↓)" />
            <Button x:Name="ReleaseButton" DockPanel.Dock="Left" Content="Liberar" Padding="12,4" Margin="0,0,8,0" Click="Release_Click"
                    ToolTip="Devuelve la ventana seleccionada a su sitio original y deja de gestionarla" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Aplicar roles" Padding="12,4" IsDefault="True" Click="Apply_Click" />
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restaurar todas" Padding="12,4" Margin="0,0,8,0" Click="Restore_Click" />
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Actualizar lista" Padding="12,4" Margin="0,0,8,0" Click="Refresh_Click" />
        </DockPanel>

        <TextBox x:Name="StatusText" DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" />

        <ListView x:Name="WindowList" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Rol" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="100"
                                          AutomationProperties.Name="{Binding App, StringFormat=Rol de {0}}"
                                          ItemsSource="{x:Static local:WindowRow.Roles}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Role"
                                          SelectedValue="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Estado" Width="130" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="App" Width="150" DisplayMemberBinding="{Binding App}" />
                    <GridViewColumn Header="Título" Width="430" DisplayMemberBinding="{Binding Title}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
