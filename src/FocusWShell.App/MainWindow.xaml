<Window x:Class="FocusWShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusWShell.App"
        Title="FocusWShell" Width="1320" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Vista:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ViewCombo" Width="170" Margin="0,0,24,0" AutomationProperties.Name="Vista"
                          SelectionChanged="ViewCombo_SelectionChanged"
                          ToolTip="Dónde va el foco en el monitor principal">
                    <ComboBoxItem Content="Foco a la izquierda" />
                    <ComboBoxItem Content="Foco al centro" />
                    <ComboBoxItem Content="Foco a la derecha" />
                </ComboBox>
                <TextBlock Text="Proporciones:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ProportionsCombo" Width="260" Margin="0,0,24,0" AutomationProperties.Name="Proporciones"
                          SelectionChanged="ProportionsCombo_SelectionChanged"
                          ToolTip="Ancho de las columnas en esta vista. También puedes arrastrar el borde de una ventana que da a la columna vecina: se guarda." />
                <Button x:Name="DeckButton" Content="Deck" Padding="10,2" Margin="0,0,8,0" Click="Deck_Click"
                        ToolTip="Mostrar u ocultar el deck en la esquina del monitor principal" />
                <Button x:Name="HotkeysButton" Content="Atajos…" Padding="10,2" Margin="0,0,24,0" Click="Hotkeys_Click"
                        ToolTip="Ver y cambiar los atajos globales" />
                <TextBlock Text="Escena:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="SceneCombo" Width="220" AutomationProperties.Name="Escenas guardadas" />
                <Button x:Name="ApplySceneButton" Content="Aplicar escena" Padding="10,2" Margin="6,0,0,0" Click="ApplyScene_Click" />
                <Button x:Name="DeleteSceneButton" Content="Borrar" Padding="10,2" Margin="6,0,24,0" Click="DeleteScene_Click" />
                <CheckBox x:Name="OpenMissingBox" Content="Abrir las que falten" VerticalAlignment="Center" Margin="0,0,24,0"
                          Checked="OpenMissing_Changed" Unchecked="OpenMissing_Changed"
                          ToolTip="Al aplicar una escena, abre las apps que no estén abiertas (si el catálogo sabe cómo) y pone su ventana en su panel." />
                <TextBox x:Name="SceneName" Width="200" VerticalContentAlignment="Center" AutomationProperties.Name="Nombre de la escena" />
                <Button x:Name="SaveSceneButton" Content="Guardar escena actual" Padding="10,2" Margin="6,0,0,0" Click="SaveScene_Click"
                        ToolTip="Guarda qué ventanas están gestionadas, en qué panel y monitor, y los templates. Si el nombre existe, la reemplaza." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Llevar al foco la ventana de un panel que elijas con:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox x:Name="GestureAltTab" Content="Alt+Tab" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Gesture_Changed" Unchecked="Gesture_Changed" />
                <CheckBox x:Name="GestureTaskView" Content="Vista de tareas (Win+Tab)" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Gesture_Changed" Unchecked="Gesture_Changed" />
                <CheckBox x:Name="GestureTaskbar" Content="Barra de tareas" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Gesture_Changed" Unchecked="Gesture_Changed" />
                <CheckBox x:Name="GestureClick" Content="Clic en la ventana" VerticalAlignment="Center" Checked="Gesture_Changed" Unchecked="Gesture_Changed"
                          ToolTip="Desactivado por defecto: con él, cada clic en un panel movería ventanas bajo el cursor." />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="DimGray"
                       Text="Elige el panel de cada ventana (o déjala libre) y pulsa Aplicar. El foco está siempre en el monitor principal. En la sección Paneles puedes renombrarlos, moverlos a otro monitor, cambiar su presentación, borrarlos o crear nuevos; borrar un panel deja sus ventanas libres, donde estén." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="PromoteButton" DockPanel.Dock="Left" Content="Al Centro" Padding="12,4" Margin="0,0,8,0" Click="Promote_Click"
                    ToolTip="Lleva la ventana seleccionada al Centro" />
            <Button x:Name="FullscreenButton" DockPanel.Dock="Left" Content="Pantalla completa" Padding="12,4" Margin="0,0,4,0" Click="Fullscreen_Click"
                    ToolTip="Maximiza la ventana seleccionada en el monitor elegido; si ya lo está, vuelve al foco" />
            <ComboBox x:Name="FullscreenTarget" DockPanel.Dock="Left" Width="130" Margin="0,0,8,0" AutomationProperties.Name="Monitor de pantalla completa" />
            <Button x:Name="SwapButton" DockPanel.Dock="Left" Content="Volver a la anterior" Padding="12,4" Margin="0,0,8,0" Click="Swap_Click"
                    ToolTip="Devuelve al Centro la ventana que estaba antes" />
            <Button x:Name="ReturnButton" DockPanel.Dock="Left" Content="Centro al panel" Padding="12,4" Margin="0,0,8,0" Click="Return_Click"
                    ToolTip="Devuelve la ventana del Centro a su panel" />
            <Button x:Name="ParkButton" DockPanel.Dock="Left" Content="Estacionar" Padding="12,4" Margin="0,0,8,0" Click="Park_Click"
                    ToolTip="Aparta la ventana seleccionada (minimizada) sin quitarle su panel. También pasa si la minimizas tú." />
            <Button x:Name="UnparkButton" DockPanel.Dock="Left" Content="Recuperar" Padding="12,4" Margin="0,0,8,0" Click="Unpark_Click"
                    ToolTip="Devuelve una ventana estacionada a su panel, en el puesto que tenía. También pasa si la abres desde la barra de tareas." />
            <Button x:Name="ReattachButton" DockPanel.Dock="Left" Content="Reencajar" Padding="12,4" Margin="0,0,8,0" Click="Reattach_Click"
                    ToolTip="Devuelve al layout una ventana que maximizaste tú" />
            <Button x:Name="ReleaseButton" DockPanel.Dock="Left" Content="Liberar" Padding="12,4" Margin="0,0,8,0" Click="Release_Click"
                    ToolTip="Devuelve la ventana seleccionada a su sitio original y deja de gestionarla" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Aplicar" Padding="12,4" IsDefault="True" Click="Apply_Click" />
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restaurar todas" Padding="12,4" Margin="0,0,8,0" Click="Restore_Click" />
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Actualizar lista" Padding="12,4" Margin="0,0,8,0" Click="Refresh_Click" />
        </DockPanel>

        <TextBox x:Name="StatusText" DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" />

        <GroupBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="6">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Apps conocidas (se añaden solas al verlas abiertas)" VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowHiddenApps" Content="Ver ocultas" Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="ShowHiddenApps_Changed" Unchecked="ShowHiddenApps_Changed" />
                </StackPanel>
            </GroupBox.Header>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CatalogList" />
            </ScrollViewer>
        </GroupBox>

        <GroupBox DockPanel.Dock="Bottom" Header="Excluidas: FocusWShell no las gestiona ni las muestra (clic derecho en una ventana para excluirla)" Margin="0,8,0,0" Padding="6">
            <StackPanel>
                <WrapPanel x:Name="ExclusionsList" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox x:Name="ExclusionKindCombo" Width="150" SelectedIndex="0" AutomationProperties.Name="Tipo de exclusión">
                        <ComboBoxItem Content="Ejecutable" />
                        <ComboBoxItem Content="AUMID" />
                        <ComboBoxItem Content="Clase de ventana" />
                    </ComboBox>
                    <TextBox x:Name="ExclusionValueBox" Width="260" Margin="6,0" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Qué excluir" ToolTip="Por ejemplo NetBird.exe" />
                    <Button Content="Excluir" Padding="12,2" Click="AddExclusion_Click" AutomationProperties.Name="Agregar exclusión" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Bottom" Header="Paneles" Margin="0,8,0,0" Padding="6">
            <StackPanel x:Name="PanelsList" />
        </GroupBox>

        <ListView x:Name="WindowList" SelectionMode="Single" ContextMenuOpening="WindowList_ContextMenuOpening">
            <ListView.ContextMenu>
                <ContextMenu />
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Panel" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="280"
                                          AutomationProperties.Name="{Binding App, StringFormat=Panel de {0}}"
                                          ItemsSource="{Binding DataContext.AssignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding Assignment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding Manageable}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Estado" Width="220" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="App" Width="150" DisplayMemberBinding="{Binding App}" />
                    <GridViewColumn Header="Título" Width="360" DisplayMemberBinding="{Binding Title}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
