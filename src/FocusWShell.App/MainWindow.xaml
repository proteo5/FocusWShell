<ui:FluentWindow x:Class="FocusWShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:FocusWShell.App"
        Title="FocusWShell" Width="1180" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/Assets/FocusWShell.ico">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos de WPF-UI sólo para esta ventana (el deck y las tiras se dibujan a mano). -->
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Título de cada sección y su descripción. -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PageHelp" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Section" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Padding" Value="0,0,16,16" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="FocusWShell" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/FocusWShell.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navegación, como Configuración de Windows. -->
            <DockPanel Grid.Column="0" Margin="8,4,8,12">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="14,8,0,0" Style="{StaticResource Hint}" />
                <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="FocusWShell">
                    <ListBoxItem Tag="Home"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Home}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Windows"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WindowApps24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Windows}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Panels"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Board24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Panels}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Apps"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Apps24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Apps}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Shortcuts"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Shortcuts}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Scenes"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="SlideLayout24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Scenes}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Excluded"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Prohibited24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_Excluded}" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="General"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" /><TextBlock Text="{x:Static local:Strings.Nav_General}" /></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" Margin="16,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Lo que acaba de pasar: aparece arriba y se va sola. -->
                <ui:InfoBar x:Name="StatusBar" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="0,0,16,12" />

                <Grid Grid.Row="1">
                    <!-- Inicio -->
                    <ScrollViewer x:Name="HomeSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_Home}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static local:Strings.Gen_Tagline}" Style="{StaticResource PageHelp}" />
                            <TextBlock Text="{x:Static local:Strings.Home_Monitors}" Style="{StaticResource CardTitle}" />
                            <WrapPanel x:Name="MonitorMap" Margin="0,0,0,16" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Card Grid.Column="0" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Strings.Home_Layout}" Style="{StaticResource CardTitle}" />
                                        <WrapPanel x:Name="LayoutToggles" />
                                        <DockPanel Margin="0,10,0,0">
                                            <ui:Button x:Name="ResetWidthButton" DockPanel.Dock="Right" Content="{x:Static local:Strings.Deck_ResetWidth}" Click="ResetWidth_Click"
                                                       ToolTip="{x:Static local:Strings.Main_ResetWidthTip}" />
                                            <TextBlock x:Name="ProportionsText" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static local:Strings.Home_LayoutHint}" Margin="0,8,0,0" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Grid.Column="2" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Strings.Home_Actions}" Style="{StaticResource CardTitle}" />
                                        <WrapPanel>
                                            <ui:Button Content="{x:Static local:Strings.Home_OpenDeck}" Appearance="Primary" Margin="0,0,8,8" Click="Deck_Click"
                                                       Icon="{ui:SymbolIcon Symbol=Tablet24}" ToolTip="{x:Static local:Strings.Main_DeckTip}" />
                                            <ui:Button Content="{x:Static local:Strings.Main_Swap}" Margin="0,0,8,8" Click="Swap_Click" ToolTip="{x:Static local:Strings.Main_SwapTip}" />
                                            <ui:Button Content="{x:Static local:Strings.Main_Return}" Margin="0,0,8,8" Click="Return_Click" ToolTip="{x:Static local:Strings.Main_ReturnTip}" />
                                            <ui:Button Content="{x:Static local:Strings.Main_RestoreAll}" Margin="0,0,8,8" Click="Restore_Click" />
                                            <ui:Button x:Name="RearrangeButton" Content="{x:Static local:Strings.Deck_Rearrange}" Margin="0,0,8,8" Click="Rearrange_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </ui:Card>
                            </Grid>
                            <ui:InfoBar x:Name="SafetyInfo" Title="{x:Static local:Strings.Home_SafetyTitle}" IsOpen="True" IsClosable="False"
                                        Severity="Informational" Margin="0,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Ventanas -->
                    <DockPanel x:Name="WindowsSection" Visibility="Collapsed" Margin="0,0,16,16">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{x:Static local:Strings.Nav_Windows}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static local:Strings.Win_Help}" Style="{StaticResource PageHelp}" />
                            <WrapPanel Margin="0,0,0,12">
                                <ui:Button Content="{x:Static local:Strings.Main_Refresh}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Margin="0,0,8,0" Click="Refresh_Click" />
                                <ui:Button Content="{x:Static local:Strings.Main_Swap}" Margin="0,0,8,0" Click="Swap_Click" ToolTip="{x:Static local:Strings.Main_SwapTip}" />
                                <ui:Button Content="{x:Static local:Strings.Main_Return}" Margin="0,0,8,0" Click="Return_Click" ToolTip="{x:Static local:Strings.Main_ReturnTip}" />
                                <ui:Button Content="{x:Static local:Strings.Main_RestoreAll}" Click="Restore_Click" />
                            </WrapPanel>
                            <!-- Cabecera de la lista, con los mismos anchos que las filas. -->
                            <Grid Margin="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static local:Strings.Win_ColApp}" Style="{StaticResource Hint}" />
                                <TextBlock Grid.Column="1" Text="{x:Static local:Strings.Main_ColTitle}" Style="{StaticResource Hint}" />
                                <TextBlock Grid.Column="2" Text="{x:Static local:Strings.Main_ColState}" Style="{StaticResource Hint}" />
                                <TextBlock Grid.Column="3" Text="{x:Static local:Strings.Win_ColPanel}" Style="{StaticResource Hint}" />
                            </Grid>
                        </StackPanel>
                        <ListView x:Name="WindowList" SelectionMode="Single" ContextMenuOpening="WindowList_ContextMenuOpening"
                                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ContextMenu>
                                <ContextMenu />
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:WindowRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding App}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Title}" />
                                        <TextBlock Grid.Column="2" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding State}" />
                                        <ComboBox Grid.Column="3"
                                                  AutomationProperties.Name="{Binding App, StringFormat=Panel: {0}}"
                                                  ItemsSource="{Binding DataContext.AssignmentOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Key"
                                                  SelectedValue="{Binding Assignment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding Manageable}" />
                                        <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}" Appearance="Transparent" Padding="8"
                                                   HorizontalAlignment="Right" Click="RowMore_Click" Tag="{Binding}"
                                                   AutomationProperties.Name="{Binding App, StringFormat=… {0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <!-- Paneles -->
                    <ScrollViewer x:Name="PanelsSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_Panels}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static local:Strings.Main_PanelsHelp}" Style="{StaticResource PageHelp}" />
                            <StackPanel x:Name="PanelsList" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Apps -->
                    <ScrollViewer x:Name="AppsSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_Apps}" Style="{StaticResource PageTitle}" />
                            <DockPanel Margin="0,0,0,16">
                                <ui:ToggleSwitch x:Name="ShowHiddenApps" DockPanel.Dock="Right" Content="{x:Static local:Strings.Main_ShowHidden}" Margin="16,0,0,0"
                                                 Checked="ShowHiddenApps_Changed" Unchecked="ShowHiddenApps_Changed" />
                                <TextBlock Text="{x:Static local:Strings.Main_AppsHelp}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <StackPanel x:Name="CatalogList" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Atajos y gestos -->
                    <ScrollViewer x:Name="ShortcutsSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_Shortcuts}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static local:Strings.Sc_KeysHelp}" Style="{StaticResource PageHelp}" />
                            <ui:Card Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="{x:Static local:Strings.Sc_Edit}" Icon="{ui:SymbolIcon Symbol=Edit24}" Click="Hotkeys_Click"
                                                   ToolTip="{x:Static local:Strings.Main_HotkeysTip}" />
                                        <TextBlock Text="{x:Static local:Strings.Sc_Keys}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <Grid x:Name="ShortcutList" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card>
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Sc_Gestures}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static local:Strings.Sc_GesturesHelp}" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                                    <ui:ToggleSwitch x:Name="GestureAltTab" Content="Alt+Tab" Margin="0,0,0,8" Checked="Gesture_Changed" Unchecked="Gesture_Changed" />
                                    <ui:ToggleSwitch x:Name="GestureTaskView" Content="{x:Static local:Strings.Main_GestureTaskView}" Margin="0,0,0,8" Checked="Gesture_Changed" Unchecked="Gesture_Changed" />
                                    <ui:ToggleSwitch x:Name="GestureTaskbar" Content="{x:Static local:Strings.Main_GestureTaskbar}" Margin="0,0,0,8" Checked="Gesture_Changed" Unchecked="Gesture_Changed" />
                                    <ui:ToggleSwitch x:Name="GestureClick" Content="{x:Static local:Strings.Main_GestureClick}" Checked="Gesture_Changed" Unchecked="Gesture_Changed"
                                                     ToolTip="{x:Static local:Strings.Main_GestureClickTip}" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Escenas -->
                    <ScrollViewer x:Name="ScenesSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_Scenes}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static local:Strings.Scn_Help}" Style="{StaticResource PageHelp}" />
                            <ui:Card Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Scn_Saved}" Style="{StaticResource CardTitle}" />
                                    <WrapPanel>
                                        <ComboBox x:Name="SceneCombo" Width="260" Margin="0,0,8,8" AutomationProperties.Name="{x:Static local:Strings.Main_ScenesName}" />
                                        <ui:Button x:Name="ApplySceneButton" Content="{x:Static local:Strings.Main_ApplyScene}" Appearance="Primary" Margin="0,0,8,8" Click="ApplyScene_Click" />
                                        <ui:Button x:Name="DeleteSceneButton" Content="{x:Static local:Strings.Main_Delete}" Icon="{ui:SymbolIcon Symbol=Delete24}" Margin="0,0,8,8" Click="DeleteScene_Click" />
                                    </WrapPanel>
                                    <ui:ToggleSwitch x:Name="OpenMissingBox" Content="{x:Static local:Strings.Main_OpenMissing}" Margin="0,4,0,0"
                                                     Checked="OpenMissing_Changed" Unchecked="OpenMissing_Changed" ToolTip="{x:Static local:Strings.Main_OpenMissingTip}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card>
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Scn_SaveTitle}" Style="{StaticResource CardTitle}" />
                                    <WrapPanel>
                                        <ui:TextBox x:Name="SceneName" Width="260" Margin="0,0,8,0" PlaceholderText="{x:Static local:Strings.Scn_NamePlaceholder}"
                                                    AutomationProperties.Name="{x:Static local:Strings.Main_SceneNameName}" />
                                        <ui:Button x:Name="SaveSceneButton" Content="{x:Static local:Strings.Main_SaveScene}" Icon="{ui:SymbolIcon Symbol=Save24}" Click="SaveScene_Click"
                                                   ToolTip="{x:Static local:Strings.Main_SaveSceneTip}" />
                                    </WrapPanel>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Excluidas -->
                    <ScrollViewer x:Name="ExcludedSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_Excluded}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{x:Static local:Strings.Main_ExcludedHelp}" Style="{StaticResource PageHelp}" />
                            <StackPanel x:Name="ExclusionsList" Margin="0,0,0,12" />
                            <ui:Card>
                                <WrapPanel>
                                    <ComboBox x:Name="ExclusionKindCombo" Width="170" SelectedIndex="0" Margin="0,0,8,0" AutomationProperties.Name="{x:Static local:Strings.Main_ExclusionKindName}">
                                        <ComboBoxItem Content="{x:Static local:Strings.Main_ExclExecutable}" />
                                        <ComboBoxItem Content="AUMID" />
                                        <ComboBoxItem Content="{x:Static local:Strings.Main_ExclClass}" />
                                    </ComboBox>
                                    <ui:TextBox x:Name="ExclusionValueBox" Width="300" Margin="0,0,8,0" PlaceholderText="Code.exe"
                                                AutomationProperties.Name="{x:Static local:Strings.Main_ExclValueName}" ToolTip="{x:Static local:Strings.Main_ExclValueTip}" />
                                    <ui:Button Content="{x:Static local:Strings.Main_Exclude}" Icon="{ui:SymbolIcon Symbol=Prohibited24}" Click="AddExclusion_Click"
                                               AutomationProperties.Name="{x:Static local:Strings.Main_ExcludeName}" />
                                </WrapPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- General -->
                    <ScrollViewer x:Name="GeneralSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.Nav_General}" Style="{StaticResource PageTitle}" Margin="0,4,0,16" />
                            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=LocalLanguage24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Strings.Gen_Language}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Static local:Strings.Gen_LanguageHelp}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="LanguageCombo" Width="250" AutomationProperties.Name="{x:Static local:Strings.Main_LanguageName}"
                                          SelectionChanged="LanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static local:Strings.Main_LanguageAuto}" Tag="auto" />
                                    <ComboBoxItem Content="Español" Tag="es" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>
                            </ui:CardControl>
                            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=DarkTheme24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Strings.Gen_Theme}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Static local:Strings.Gen_ThemeHelp}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="ThemeCombo" Width="250" AutomationProperties.Name="{x:Static local:Strings.Gen_Theme}"
                                          SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static local:Strings.Gen_ThemeAuto}" Tag="auto" />
                                    <ComboBoxItem Content="{x:Static local:Strings.Gen_ThemeLight}" Tag="light" />
                                    <ComboBoxItem Content="{x:Static local:Strings.Gen_ThemeDark}" Tag="dark" />
                                </ComboBox>
                            </ui:CardControl>
                            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Symbol=Power24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Strings.Gen_Startup}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Static local:Strings.Gen_StartupHelp}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="StartupSwitch" Checked="Startup_Changed" Unchecked="Startup_Changed"
                                                 AutomationProperties.Name="{x:Static local:Strings.Gen_Startup}" />
                            </ui:CardControl>
                            <ui:CardControl Margin="0,0,0,24" Icon="{ui:SymbolIcon Symbol=Lightbulb24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:Strings.Gen_Awake}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Static local:Strings.Gen_AwakeHelp}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AwakeSwitch" Checked="Awake_Changed" Unchecked="Awake_Changed"
                                                 AutomationProperties.Name="{x:Static local:Strings.Gen_Awake}" />
                            </ui:CardControl>

                            <TextBlock Text="{x:Static local:Strings.Gen_About}" Style="{StaticResource CardTitle}" />
                            <ui:Card Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Image Source="pack://application:,,,/Assets/FocusWShell.ico" Width="48" Height="48" Margin="0,0,16,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="FocusWShell" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Gen_AboutText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Static local:Strings.Gen_AboutPrivacy}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:Card>

                            <!-- Los sitios: cada uno una fila que abre el navegador. -->
                            <ui:CardAction Margin="0,0,0,4" Icon="{ui:SymbolIcon Symbol=Book24}" Click="Manual_Click">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Gen_Manual}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Static local:Strings.Gen_ManualHelp}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,0,0,4" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Click="Releases_Click">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Gen_Releases}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Static local:Strings.Gen_ReleasesHelp}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,0,0,4" Icon="{ui:SymbolIcon Symbol=Bug24}" Click="Report_Click">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Gen_Report}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Static local:Strings.Gen_ReportHelp}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,0,0,4" Icon="{ui:SymbolIcon Symbol=Code24}" Click="Source_Click">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Gen_Source}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="github.com/proteo5/FocusWShell" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,0,0,4" Icon="{ui:SymbolIcon Symbol=Folder24}" Click="SettingsFolder_Click">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Strings.Gen_Settings}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="%LOCALAPPDATA%\FocusWShell" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </ui:CardAction>

                            <TextBlock Text="{x:Static local:Strings.Gen_License}" Style="{StaticResource CardTitle}" Margin="0,16,0,10" />
