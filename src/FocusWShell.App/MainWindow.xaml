<Window x:Class="FocusWShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusWShell.App"
        Title="FocusWShell" Width="860" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="DimGray"
                       Text="Asigna un rol a cada ventana y pulsa Aplicar. El orden de la lista es el orden dentro de cada panel (de arriba abajo). Las ventanas sin rol que estuvieran colocadas vuelven a su sitio." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" Content="Actualizar lista" Padding="12,4" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button x:Name="RestoreButton" Content="Restaurar todas" Padding="12,4" Margin="0,0,8,0" Click="Restore_Click" />
            <Button x:Name="ApplyButton" Content="Aplicar layout" Padding="12,4" IsDefault="True" Click="Apply_Click" />
        </StackPanel>

        <TextBox x:Name="StatusText" DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" />

        <ListView x:Name="WindowList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Rol" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="100"
                                          AutomationProperties.Name="{Binding App, StringFormat=Rol de {0}}"
                                          ItemsSource="{x:Static local:WindowRow.Roles}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Role"
                                          SelectedValue="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="App" Width="150" DisplayMemberBinding="{Binding App}" />
                    <GridViewColumn Header="Título" Width="520" DisplayMemberBinding="{Binding Title}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
