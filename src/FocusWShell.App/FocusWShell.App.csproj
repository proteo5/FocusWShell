<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Sólo para NotifyIcon (icono de bandeja). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FocusWShell</AssemblyName>
    <RootNamespace>FocusWShell.App</RootNamespace>
    <!-- Icono del ejecutable (Explorador, barra de tareas). Se genera con build\icono.ps1. -->
    <ApplicationIcon>Assets\FocusWShell.ico</ApplicationIcon>
    <!-- Idioma de los textos base (Strings.resx); el inglés va en Strings.en.resx. -->
    <NeutralLanguage>es</NeutralLanguage>
    <!-- WPF fija el DPI con el manifiesto compartido; WinForms sólo aporta el NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita choques de nombres entre WPF y WinForms (Application, MessageBox…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\FocusWShell.ico" />
  </ItemGroup>

  <!-- Textos de la interfaz, en español (Strings.resx) e inglés (Strings.en.resx). Strings.Designer.cs lo
       escribe la herramienta de textos: el compilador de XAML necesita la clase antes de generar recursos. -->

  <ItemGroup>
    <ProjectReference Include="..\FocusWShell.Core\FocusWShell.Core.csproj" />
    <ProjectReference Include="..\FocusWShell.Win32\FocusWShell.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
